# Inspektor Gadget Exec Collector Configuration
# Copy this file to /etc/ig-collector/ig-collector.env and fill in your values

# Required: Azure Log Analytics Workspace ID
LA_WORKSPACE_ID=

# Required: Azure Log Analytics Shared Key (Primary or Secondary)
LA_WORKSPACE_KEY=

# Optional: Custom log type name in Log Analytics (default: InspektorGadgetExec)
#LA_LOG_TYPE=InspektorGadgetExec

# Optional: Number of records to batch before sending (default: 100)
#IG_BATCH_SIZE=100

# Optional: Seconds between flushes when batch is not full (default: 30)
#IG_FLUSH_INTERVAL=30
