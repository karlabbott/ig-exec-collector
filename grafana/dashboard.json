{
  "dashboard": {
    "title": "Inspektor Gadget - Exec Calls",
    "tags": ["inspektor-gadget", "exec"],
    "timezone": "utc",
    "refresh": "30s",
    "time": { "from": "now-1h", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "Exec Calls Over Time",
        "type": "timeseries",
        "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
        "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "${DS_AZURE_MONITOR}" },
        "targets": [
          {
            "refId": "A",
            "azureLogAnalytics": {
              "query": "InspektorGadgetExec_CL\n| summarize ExecCount=count() by bin(TimeGenerated, 1m)\n| order by TimeGenerated asc",
              "resources": ["${LA_WORKSPACE_RESOURCE_ID}"],
              "resultFormat": "time_series"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 20, "pointSize": 5, "showPoints": "auto", "lineWidth": 2 },
            "displayName": "Exec Calls",
            "unit": "short"
          }
        }
      },
      {
        "id": 2,
        "title": "Top Processes by Exec Count",
        "type": "barchart",
        "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 },
        "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "${DS_AZURE_MONITOR}" },
        "targets": [
          {
            "refId": "A",
            "azureLogAnalytics": {
              "query": "InspektorGadgetExec_CL\n| where TimeGenerated > ago(1h)\n| summarize Count=count() by Comm_s\n| top 15 by Count\n| order by Count desc",
              "resources": ["${LA_WORKSPACE_RESOURCE_ID}"],
              "resultFormat": "table"
            }
          }
        ]
      },
      {
        "id": 3,
        "title": "Exec Calls by User",
        "type": "piechart",
        "gridPos": { "h": 10, "w": 12, "x": 12, "y": 10 },
        "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "${DS_AZURE_MONITOR}" },
        "targets": [
          {
            "refId": "A",
            "azureLogAnalytics": {
              "query": "InspektorGadgetExec_CL\n| where TimeGenerated > ago(1h)\n| summarize Count=count() by User_s\n| top 10 by Count",
              "resources": ["${LA_WORKSPACE_RESOURCE_ID}"],
              "resultFormat": "table"
            }
          }
        ],
        "options": { "pieType": "donut", "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] } }
      },
      {
        "id": 4,
        "title": "Total Exec Calls (Last Hour)",
        "type": "stat",
        "gridPos": { "h": 5, "w": 8, "x": 0, "y": 20 },
        "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "${DS_AZURE_MONITOR}" },
        "targets": [
          {
            "refId": "A",
            "azureLogAnalytics": {
              "query": "InspektorGadgetExec_CL\n| where TimeGenerated > ago(1h)\n| summarize TotalExecs=count()",
              "resources": ["${LA_WORKSPACE_RESOURCE_ID}"],
              "resultFormat": "table"
            }
          }
        ],
        "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 1000 }] } } },
        "options": { "colorMode": "background" }
      },
      {
        "id": 5,
        "title": "Unique Processes (Last Hour)",
        "type": "stat",
        "gridPos": { "h": 5, "w": 8, "x": 8, "y": 20 },
        "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "${DS_AZURE_MONITOR}" },
        "targets": [
          {
            "refId": "A",
            "azureLogAnalytics": {
              "query": "InspektorGadgetExec_CL\n| where TimeGenerated > ago(1h)\n| summarize UniqueProcesses=dcount(Comm_s)",
              "resources": ["${LA_WORKSPACE_RESOURCE_ID}"],
              "resultFormat": "table"
            }
          }
        ],
        "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "blue", "value": null }, { "color": "purple", "value": 20 }] } } },
        "options": { "colorMode": "background" }
      },
      {
        "id": 6,
        "title": "Execs Per Minute (Avg)",
        "type": "stat",
        "gridPos": { "h": 5, "w": 8, "x": 16, "y": 20 },
        "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "${DS_AZURE_MONITOR}" },
        "targets": [
          {
            "refId": "A",
            "azureLogAnalytics": {
              "query": "InspektorGadgetExec_CL\n| where TimeGenerated > ago(1h)\n| summarize ExecCount=count() by bin(TimeGenerated, 1m)\n| summarize AvgPerMinute=avg(ExecCount)",
              "resources": ["${LA_WORKSPACE_RESOURCE_ID}"],
              "resultFormat": "table"
            }
          }
        ],
        "fieldConfig": { "defaults": { "decimals": 1, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 50 }] } } },
        "options": { "colorMode": "background" }
      }
    ],
    "schemaVersion": 39
  },
  "overwrite": true
}
